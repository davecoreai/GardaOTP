# Supabase (server + public anon config; never expose service role)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# NokosPusat (server only)
NOKOS_API_KEY=YOUR_NOKOS_API_KEY
NOKOS_BASE_URL=https://nokospusat.com

# SekaliPay merchant credentials (server only)
SEKALIPAY_API_KEY=YOUR_SEKALIPAY_API_KEY
SEKALIPAY_SECRET_KEY=YOUR_SEKALIPAY_SECRET_KEY
SEKALIPAY_BASE_URL=https://sekalipay.com/api/v1/gateway
SEKALIPAY_PAYMENT_CODE=QRIS
SEKALIPAY_IS_SANDBOX=true

APP_URL=https://YOUR-PROJECT.vercel.app
